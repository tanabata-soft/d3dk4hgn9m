      "startMs": 151000,
      "endMs": 156000
    },
    {
      "text": "私を強く 抱きしめていて",
      "startMs": 156000,
      "endMs": 160000
    }
  ],
  "kiri": [
    {
      "text": "雨上がりの木曽を一人で歩いている",
      "startMs": 12000,
      "endMs": 14600
    },
    {
      "text": "霧に包まれた宿場町はモノクロの世界",
      "startMs": 14600,
      "endMs": 17000
    },
    {
      "text": "石畳を踏みしめる音が静かに響く",
      "startMs": 17000,
      "endMs": 19700
    },
    {
      "text": "私の心の中は今も激しく揺れている",
      "startMs": 19700,
      "endMs": 22300
    },
    {
      "text": "スクリーンの彼方で見たあの狂気的な瞳",
      "startMs": 22300,
      "endMs": 24800
    },
    {
      "text": "ニコラスの存在がこの静寂を切り裂く",
      "startMs": 24800,
      "endMs": 27300
    },
    {
      "text": "現実はどこで終わり妄想はどこから始まる？",
      "startMs": 27300,
      "endMs": 29800
    },
    {
      "text": "ただ一つの確かな記憶を探しているの",
      "startMs": 29800,
      "endMs": 32200
    },
    {
      "text": "木曽の山並みが夕闇に沈んでいく",
      "startMs": 32200,
      "endMs": 36600
    },
    {
      "text": "あなたの面影が風に舞って消えてゆく",
      "startMs": 36600,
      "endMs": 41900
    },
    {
      "text": "果てしない孤独と静かな美しさの中で",
      "startMs": 41900,
      "endMs": 46700
    },
    {
      "text": "もう戻れない場所へ心が惹かれていく",
      "startMs": 46700,
      "endMs": 49400
    },
    {
      "text": "切ないメロディが胸の奥で鳴り止まない",
      "startMs": 49400,
      "endMs": 52500
    },
    {
      "text": "おい見ろよこの深い霧の向こう側を",
      "startMs": 52500,
      "endMs": 54500
    },
    {
      "text": "お前が見ているのは現実かそれとも幻か？",
      "startMs": 54500,
      "endMs": 57100
    },
    {
      "text": "俺の魂はこの大自然の中で叫んでいる",
      "startMs": 57100,
      "endMs": 59800
    },
    {
      "text": "ハリウッドの狂気もこの静寂には敵わない！",
      "startMs": 59800,
      "endMs": 62100
    },
    {
      "text": "ニコラス・ケイジの名を呼ぶ風が聞こえるか？",
      "startMs": 62100,
      "endMs": 64400
    },
    {
      "text": "木曽の谷底から這い上がる感情の嵐",
      "startMs": 64400,
      "endMs": 67200
    },
    {
      "text": "逃げ場なんてないこの圧倒的な存在感に",
      "startMs": 67200,
      "endMs": 69700
    },
    {
      "text": "お前も俺もただ飲み込まれていくだけだ！",
      "startMs": 69700,
      "endMs": 72300
    },
    {
      "text": "交差する二つの世界が一つに溶けていく",
      "startMs": 72300,
      "endMs": 74800
    },
    {
      "text": "静寂と狂気が響き合うこの場所で",
      "startMs": 74800,
      "endMs": 77200
    },
    {
      "text": "（見失うな！） 本当の自分を、その光を",
      "startMs": 77200,
      "endMs": 79700
    },
    {
      "text": "私はここで強く生きていくと誓うから",
      "startMs": 79700,
      "endMs": 91600
    },
    {
      "text": "木曽の山並みが夕闇に沈んでいく",
      "startMs": 91600,
      "endMs": 96500
    },
    {
      "text": "あなたの面影が風に舞って消えてゆく",
      "startMs": 96500,
      "endMs": 101800
    },
    {
      "text": "果てしない孤独と静かな美しさの中で",
      "startMs": 101800,
      "endMs": 106700
    },
    {
      "text": "私はまだあの強烈な光を求めている",
      "startMs": 106700,
      "endMs": 109900
    },
    {
      "text": "木曽の山並みが夕闇に沈んでいく",
      "startMs": 109900,
      "endMs": 112100
    },
    {
      "text": "あなたの面影が風に舞って消えてゆく",
      "startMs": 112100,
      "endMs": 116300
    },
    {
      "text": "果てしない孤独と静かな美しさの中で",
      "startMs": 116300,
      "endMs": 121400
    },
    {
      "text": "私はまだあの強烈な光を求めている",
      "startMs": 121400,
      "endMs": 126600
    },
    {
      "text": "もう戻れない場所へ心が惹かれていく",
      "startMs": 126600,
      "endMs": 129400
    },
    {
      "text": "切ないメロディが胸の奥で鳴り止まない",
      "startMs": 129400,
      "endMs": 132800
    },
    {
      "text": "（霧の中に消えていく…）",
      "startMs": 132800,
      "endMs": 135100
    },
    {
      "text": "ニコラスと私、そしてこの木曽の夜が明ける",
      "startMs": 135100,
      "endMs": 141500
    },
    {
      "text": "（静かに、ただ静かに…）",
      "startMs": 141500,
      "endMs": 145500
    }
  ],
